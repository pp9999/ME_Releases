{
  "$schema": "https://opencode.ai/config.json",
  // Bot client MCP bridge (same stdio wrapper as .vscode/mcp.json).
  // Tools are exposed as mcp_botclient_*, mcp_botclient2_*, mcp_botclient3_*
  // and stay enabled in every session started from this workspace.
  "mcp": {
    "servers": {
      // botclient-osrs
      "mcp_botclient": {
        "type": "local",
        "command": [
          "python",
          "MemoryError/botclientmcp/mcp_botclient.py",
          "--bot-rpc",
          "http://127.0.0.1:18644"
        ]
      },
      // botclient-rs3 (usually the live one)
      "mcp_botclient2": {
        "type": "local",
        "command": [
          "python",
          "MemoryError/botclientmcp/mcp_botclient.py",
          "--bot-rpc",
          "http://127.0.0.1:18642"
        ]
      },
      // botclient-runelite
      "mcp_botclient3": {
        "type": "local",
        "command": [
          "python",
          "MemoryError/botclientmcp/mcp_botclient.py",
          "--bot-rpc",
          "http://127.0.0.1:18643"
        ]
      }
    }
  }
}
